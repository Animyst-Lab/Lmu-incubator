# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (Preview and Production).
# Never commit real values.

# Hero chat matcher. Without a key, the site uses the keyword matcher instead.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=

# Rate limiting for /api/match (10 per minute, 30 per day per visitor).
# Without these, requests aren't rate limited. The Vercel Upstash
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
