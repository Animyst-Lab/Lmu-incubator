{
  // The student workspace: a GitHub Codespace with everything already installed.
  // Students open it on their branch, type `claude`, and start.
  "name": "Lion Share",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "npm ci",
  // Pre-answer Claude Code's first-run questions (see claude-setup.mjs). Runs on
  // start and again on attach, when the Codespaces secret is sure to be set.
  "postStartCommand": "node .devcontainer/claude-setup.mjs",
  "postAttachCommand": "node .devcontainer/claude-setup.mjs",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Lion Share preview", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {
        // Show the README formatted, not as raw markdown.
        "workbench.editorAssociations": { "README.md": "vscode.markdown.preview.editor" }
      }
    }
  }
}
